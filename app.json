{
  "expo": {
    "name": "Vuelo",
    "slug": "vuelo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vuelo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vuelo.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "Vuelo подключается к кольцу Vuelo Ring, чтобы получать данные о сне, пульсе и активности."
        }
      ],
      "./plugins/with-ios-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
