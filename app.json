{
  "expo": {
    "name": "Vuelo",
    "slug": "vuelo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vuelo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.vuelo.ring",
      "infoPlist": {
        "EXDevMenuShowFloatingActionButton": false
      },
      "appleTeamId": "DXMFBFFYHQ"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0B0B0F"
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "Bluetooth нужен, чтобы подключаться к кольцу Vuelo Ring и забирать с него данные о сне, пульсе, кислороде и активности. Данные остаются на телефоне.",
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ]
        }
      ],
      "expo-task-manager",
      "expo-background-fetch",
      "./plugins/with-ios-scene-lifecycle",
      "./plugins/with-signing-team"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
